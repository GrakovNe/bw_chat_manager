# Токен бота от @BotFather. Обязательный.
TELEGRAM_TOKEN=0000000000:REPLACE_ME

# Сообщения короче этого числа символов игнорируются (не проверяются и не удаляются).
MIN_LENGTH=10

# Telegram user id администраторов через запятую.
ADMIN_IDS=93179449

# Каталог с bw_buildings.txt и chat_settings.json.
DATA_DIR=data

# DEBUG, INFO, WARNING, ERROR или CRITICAL. level выше INFO не скрывает ничего
# важного, но httpx пишет обращения к Telegram полностью — токен бота в журнал
# не попадает, эти логгеры приглушены до WARNING всегда.
LOG_LEVEL=INFO

# За сколько дней помнить оставленные сообщения, чтобы искать повторы.
DUP_WINDOW_DAYS=7

# Порог похожести от 0 до 1: совпадение выше порога — повтор.
DUP_THRESHOLD=0.9


# Тексты ответов. Необязательные, значения по умолчанию — в src/bwbot/config.py
# Перенос строки задаётся последовательностью \n (многострочные значения .env не держит).
#ON_DELETE_REPLY=
#SILENT_ON_REPLY=
#SILENT_OFF_REPLY=
#SILENT_USAGE_REPLY=
#NOT_ADMIN_REPLY=
#BAN_BUTTON_LABEL=
#BAN_DONE_REPLY=
#BAN_FAILED_REPLY=
#BAN_ADMIN_REPLY=
#BAN_BROKEN_REPLY=
#DUP_REPORT=
#DUP_DELETE_LABEL=
#DUP_DELETED_REPLY=
#DUP_DELETE_FAILED_REPLY=
#DUP_DELETE_DONE_NOTE=
#DUP_BROKEN_REPLY=

# В DUP_REPORT доступны подстановки {chat_id}, {user_label}, {text},
# {matched_age}, {score}; в DUP_DELETE_DONE_NOTE — {by}.
