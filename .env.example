# Bot token from @BotFather. Required.
TELEGRAM_TOKEN=0000000000:REPLACE_ME

# Messages shorter than this number of characters are ignored (neither checked nor deleted).
MIN_LENGTH=10

# Telegram user ids of the administrators, comma-separated.
ADMIN_IDS=93179449

# Directory with bw_buildings.txt and chat_settings.json.
DATA_DIR=data

# DEBUG, INFO, WARNING, ERROR or CRITICAL. A level above INFO hides nothing important,
# but httpx logs calls to Telegram in full — the bot token does not end up in the log,
# these loggers are always muted to WARNING.
LOG_LEVEL=INFO

# How many days to remember kept messages in order to look for repeats.
DUP_WINDOW_DAYS=7

# Similarity threshold from 0 to 1: a match above the threshold is a repeat.
DUP_THRESHOLD=0.9


# Reply texts. Optional, the default values are in src/bwbot/config.py
# A line break is written as the \n sequence (.env cannot hold multiline values).
#ON_DELETE_REPLY=
#SILENT_ON_REPLY=
#SILENT_OFF_REPLY=
#SILENT_USAGE_REPLY=
#NOT_ADMIN_REPLY=
#BAN_BUTTON_LABEL=
#BAN_DONE_REPLY=
#BAN_FAILED_REPLY=
#BAN_ADMIN_REPLY=
#BAN_BROKEN_REPLY=
#DUP_REPORT=
#DUP_DELETE_LABEL=
#DUP_DELETED_REPLY=
#DUP_DELETE_FAILED_REPLY=
#DUP_DELETE_DONE_NOTE=
#DUP_BROKEN_REPLY=

# In DUP_REPORT the substitutions {chat_id}, {user_label}, {text},
# {matched_age}, {score} are available; in DUP_DELETE_DONE_NOTE — {by}.
